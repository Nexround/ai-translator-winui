<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AiTranslator.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Enter"
            Invoked="TranslateKeyboardAccelerator_Invoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid x:Name="MainView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,12"
                Background="{StaticResource TranslatorAccentBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="翻译助手" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#DDE9FF"
                            Text="兼容 OpenAI Chat Completions API" />
                    </StackPanel>

                    <ComboBox
                        x:Name="TargetLanguageComboBox"
                        Grid.Column="1"
                        Width="138"
                        Header="目标语言"
                        SelectionChanged="TargetLanguageComboBox_SelectionChanged" />

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Click="OpenSettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE713;" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceGrid"
                Grid.Row="1"
                Padding="20,16"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="原文" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="ClearButton_Click"
                                Content="清空" />
                        </Grid>

                        <TextBox
                            x:Name="SourceTextBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AutomationProperties.Name="原文"
                            BorderThickness="0"
                            FontSize="16"
                            HorizontalAlignment="Stretch"
                            Padding="4"
                            Paste="SourceTextBox_Paste"
                            PlaceholderText="输入或粘贴要翻译的文本…"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="译文" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="CopyButton_Click"
                                Content="复制" />
                        </Grid>

                        <TextBox
                            x:Name="TargetTextBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AutomationProperties.Name="译文"
                            BorderThickness="0"
                            FontSize="16"
                            IsReadOnly="True"
                            Padding="4"
                            PlaceholderText="翻译结果将在这里流式显示"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="20,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock
                        x:Name="StatusTextBlock"
                        MaxWidth="320"
                        VerticalAlignment="Center"
                        Text="就绪"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="TranslateButton"
                            MinWidth="180"
                            Click="TranslateButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    x:Name="TranslateProgressRing"
                                    Width="16"
                                    Height="16"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="TranslateButtonText" Text="翻译  Ctrl+Enter" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CancelTranslationButton"
                            Click="CancelTranslationButton_Click"
                            Content="取消"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SettingsView"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,12"
                Background="{StaticResource TranslatorAccentBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        VerticalAlignment="Center"
                        Click="CancelSettingsButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="设置" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel
                    MaxWidth="720"
                    Margin="28,24,28,32"
                    HorizontalAlignment="Center"
                    Spacing="16">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="API 配置" />
                            <PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                Header="API Key"
                                PasswordRevealMode="Peek"
                                PlaceholderText="sk-…" />
                            <TextBox
                                x:Name="BaseUrlTextBox"
                                Header="Base URL"
                                PlaceholderText="https://api.openai.com/v1" />
                            <TextBox
                                x:Name="ModelTextBox"
                                Header="模型"
                                PlaceholderText="gpt-4o-mini" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    x:Name="TestConnectionButton"
                                    Click="TestConnectionButton_Click"
                                    Content="测试连接" />
                                <ProgressRing
                                    x:Name="TestProgressRing"
                                    Width="20"
                                    Height="20"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="TestStatusTextBlock"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="系统提示词" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ResetPromptButton_Click"
                                    Content="恢复默认" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{}{target_lang} 将替换为当前选择的目标语言" />
                            <TextBox
                                x:Name="SystemPromptTextBox"
                                MinHeight="150"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Click="CancelSettingsButton_Click"
                            Content="取消" />
                        <Button
                            Click="SaveSettingsButton_Click"
                            Content="保存"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
