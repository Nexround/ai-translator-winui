<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AiTranslator.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="MainView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,12"
                Background="{StaticResource TranslatorAccentBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="翻译助手" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#DDE9FF"
                            Text="中英翻译 · 英文单词词典" />
                    </StackPanel>

                    <ComboBox
                        x:Name="TargetLanguageComboBox"
                        Grid.Column="1"
                        Width="138"
                        Header="目标语言"
                        SelectionChanged="TargetLanguageComboBox_SelectionChanged" />

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Click="OpenSettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE713;" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceGrid"
                Grid.Row="1"
                Padding="20,16"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="原文" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="ClearButton_Click"
                                Content="清空" />
                        </Grid>

                        <TextBox
                            x:Name="SourceTextBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AutomationProperties.Name="原文"
                            BeforeTextChanging="SourceTextBox_BeforeTextChanging"
                            BorderThickness="0"
                            FontSize="16"
                            HorizontalAlignment="Stretch"
                            Padding="4"
                            Paste="SourceTextBox_Paste"
                            PlaceholderText="输入文字翻译，或输入英文单词查词…"
                            TextChanged="SourceTextBox_TextChanged"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    x:Name="ResultTitleTextBlock"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="译文" />
                                <TextBlock
                                    x:Name="ResultSourceTextBlock"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="AI 翻译" />
                            </StackPanel>
                            <Button
                                x:Name="CopyButton"
                                HorizontalAlignment="Right"
                                Click="CopyButton_Click"
                                Content="复制" />
                        </Grid>

                        <TextBox
                            x:Name="TargetTextBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AutomationProperties.Name="译文"
                            BorderThickness="0"
                            FontSize="16"
                            IsReadOnly="True"
                            Padding="4"
                            PlaceholderText="翻译结果将在这里流式显示"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top" />

                        <Grid
                            x:Name="DictionaryView"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="DictionaryLoadingView"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="28"
                                    Height="28"
                                    IsActive="True" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="正在查询 UAPI 词典…" />
                            </StackPanel>

                            <StackPanel
                                x:Name="DictionaryMessageView"
                                MaxWidth="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="Collapsed">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8A1;" />
                                <TextBlock
                                    x:Name="DictionaryMessageTextBlock"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="RetryDictionaryButton_Click"
                                        Content="重试" />
                                    <Button
                                        Click="UseAiTranslationButton_Click"
                                        Content="改用 AI 翻译" />
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer
                                x:Name="DictionaryContentView"
                                HorizontalScrollBarVisibility="Disabled"
                                SizeChanged="DictionaryContentView_SizeChanged"
                                Visibility="Collapsed"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="4,2,8,12" Spacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            x:Name="DictionaryWordTextBlock"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="DictionaryTagsTextBlock"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid x:Name="DictionaryColumnsGrid" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="DictionarySecondaryGridColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="8">
                                                <Border
                                                    Padding="12,8"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="英式" />
                                                        <TextBlock
                                                            x:Name="DictionaryUkPhoneticTextBlock"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            x:Name="DictionaryUkAudioButton"
                                                            Grid.Column="2"
                                                            AutomationProperties.Name="播放英式发音"
                                                            Click="DictionaryUkAudioButton_Click"
                                                            Content="▶ 发音"
                                                            ToolTipService.ToolTip="播放英式发音" />
                                                    </Grid>
                                                </Border>
                                                <Border
                                                    Padding="12,8"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="美式" />
                                                        <TextBlock
                                                            x:Name="DictionaryUsPhoneticTextBlock"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            x:Name="DictionaryUsAudioButton"
                                                            Grid.Column="2"
                                                            AutomationProperties.Name="播放美式发音"
                                                            Click="DictionaryUsAudioButton_Click"
                                                            Content="▶ 发音"
                                                            ToolTipService.ToolTip="播放美式发音" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel x:Name="DictionaryDefinitionsSection" Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="中文释义" />
                                                <ItemsControl x:Name="DictionaryDefinitionsItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="0,0,0,7"
                                                                Padding="12,10"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    Text="{Binding DisplayText}"
                                                                    TextWrapping="Wrap" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="DictionarySecondaryColumn" Grid.Column="1" Spacing="16">
                                            <StackPanel x:Name="DictionaryExamplesSection" Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="双语例句" />
                                                <ItemsControl x:Name="DictionaryExamplesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10" Spacing="3">
                                                                <TextBlock
                                                                    Text="{Binding Source}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding Translation}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel x:Name="DictionaryPhrasesSection" Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="常用搭配" />
                                                <ItemsControl x:Name="DictionaryPhrasesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    MaxWidth="160"
                                                                    Text="{Binding Phrase}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding Meaning}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel x:Name="DictionaryFormsSection" Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="词形变化" />
                                                <TextBlock
                                                    x:Name="DictionaryFormsTextBlock"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel x:Name="DictionaryEnglishSection" Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="英英释义" />
                                                <ItemsControl x:Name="DictionaryEnglishItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="0,0,0,8"
                                                                Padding="12,10"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    Text="{Binding DisplayText}"
                                                                    TextWrapping="Wrap" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="UseAiTranslationButton_Click"
                                        Content="改用 AI 翻译" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="词典数据由 UAPI 提供。单词查词无需配置 AI API Key。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="20,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock
                        x:Name="StatusTextBlock"
                        MaxWidth="320"
                        VerticalAlignment="Center"
                        Text="就绪"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="TranslateButton"
                            MinWidth="180"
                            Click="TranslateButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    x:Name="TranslateProgressRing"
                                    Width="16"
                                    Height="16"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="TranslateButtonText" Text="翻译  Ctrl+Enter" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CancelTranslationButton"
                            Click="CancelTranslationButton_Click"
                            Content="取消"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SettingsView"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="20,12"
                Background="{StaticResource TranslatorAccentBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        VerticalAlignment="Center"
                        Click="CancelSettingsButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="设置" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel
                    MaxWidth="720"
                    Margin="28,24,28,32"
                    HorizontalAlignment="Center"
                    Spacing="16">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="API 配置" />
                            <PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                Header="API Key"
                                PasswordRevealMode="Peek"
                                PlaceholderText="sk-…" />
                            <TextBox
                                x:Name="BaseUrlTextBox"
                                Header="Base URL"
                                PlaceholderText="https://api.openai.com/v1" />
                            <TextBox
                                x:Name="ModelTextBox"
                                Header="模型"
                                PlaceholderText="gpt-4o-mini" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    x:Name="TestConnectionButton"
                                    Click="TestConnectionButton_Click"
                                    Content="测试连接" />
                                <ProgressRing
                                    x:Name="TestProgressRing"
                                    Width="20"
                                    Height="20"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="TestStatusTextBlock"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="系统提示词" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ResetPromptButton_Click"
                                    Content="恢复默认" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{}{target_lang} 将替换为当前选择的目标语言" />
                            <TextBox
                                x:Name="SystemPromptTextBox"
                                MinHeight="150"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Click="CancelSettingsButton_Click"
                            Content="取消" />
                        <Button
                            Click="SaveSettingsButton_Click"
                            Content="保存"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
